# Application
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Database
# If PostgreSQL is not installed, the app auto-starts an embedded Postgres on this URL.
DATABASE_URL=postgresql://gnn_ids:gnn_ids_secret@localhost:5432/gnn_ids

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000
VITE_API_URL=http://localhost:5000

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gnn-ids.local

# Security
CORS_ORIGIN=http://localhost:5000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Data paths
DATA_DIR=./data
MODEL_DIR=./ai/models
# Local benchmark CSVs (CICIDS2017, etc.)
DATASET_ROOT=./DataSet
